classDiagram
    direction TB

    class ParkingManagementSystem {
        <<GUI>>
        -ParkingFacade lot
        -VehicleCreator carCreator
        -VehicleCreator motorcycleCreator
        -UIComponentFactory uiFactory
        -SlotGrid slotGrid
        -List~LotObserver~ lotObservers
        -LayoutStrategy currentLayout
        -JButton[] slotButtons
        -initComponents()
        -setupSlotGrid()
        -setupTimeControlShortcut()
        -toggleTimeControls()
        -adjustSimulatedTime(minutes)
        -resetSimulatedTime()
        -parkVehicle()
        -exitVehicle()
        -finishCheckOut(plate)
        -showSlotInfo(index)
        -showPage(entryPage)
        -refreshSlotMap()
        -calculateTicketWidth() int
        -notifyLotObservers()
        -showError(ex)
        ~setLayoutStrategy(strategy)
    }

    %% ===== GUI PATTERNS =====
    class UIComponentFactory {
        <<interface, Abstract Factory>>
        +createButton(text) JButton
        +createLabel(text) JLabel
        +createTextField() JTextField
        +createCheckBox(text) JCheckBox
        +createPanel() JPanel
        +createScrollPane(view) JScrollPane
        +createDefaultFont() Font
        +createLineBorder(color) Border
        +createEmptyBorder(t, l, b, r) Border
    }
    class DefaultUIComponentFactory

    class SlotButtonBuilder {
        <<Builder>>
        -UIComponentFactory factory
        -String name
        +setName(name) SlotButtonBuilder
        +setFont(font) SlotButtonBuilder
        +setForeground(color) SlotButtonBuilder
        +setActionListener(listener) SlotButtonBuilder
        +build() SlotComponent
    }

    class SlotGrid {
        <<Composite>>
        -List~SlotComponent~ slots
        +add(slot)
        +get(index) SlotComponent
        +size() int
        +clear()
    }
    class SlotComponent {
        <<Leaf>>
        -JButton button
        -String plate
        -String vehicleType
        +setOccupied(plate, type)
        +setFree()
        +isOccupied() boolean
    }

    class LotObserver {
        <<interface, Observer>>
        +onLotChanged()
    }

    class LayoutStrategy {
        <<interface, Strategy>>
        +layoutContainer(parent)
        +getName() String
    }
    class BorderLayoutStrategy
    class GridLayoutStrategy
    class FlowLayoutStrategy

    %% ===== FACADE (structural) =====
    class ParkingFacade {
        <<Facade>>
        -SlotManager slots
        -FeeCalculator fees
        -Map~String, ParkingRecord~ parked
        -int ticketCount
        -long timeOffsetMillis
        +park(Vehicle) ParkingRecord
        +checkOut(plate) ParkingRecord
        +getRecord(plate) ParkingRecord
        +getParkedPlates() String[]
        +getSlotCount() int
        +getSlotName(index) String
        +getSlotPlate(index) String
        +getCurrentTime() Date
        +advanceTimeMinutes(minutes)
        +resetTime()
        +getTimeOffsetMinutes() long
    }
    class SlotManager {
        -String[] plates
        +size() int
        +assignFirstFree(plate) int
        +release(plate) int
        +nameOf(index) String
        +getPlate(index) String
    }
    class FeeCalculator {
        +minutesParked(in, out) long
        +billedHours(minutes) long
        +fee(hours, rate) long
    }
    class ParkingRecord {
        -String ticketNo
        -Vehicle vehicle
        -String slot
        -Date timeIn
        -Date timeOut
        -long minutes
        -long hours
        -long fee
        +checkOut(timeOut, minutes, hours, fee)
    }
    class ParkingException {
        -String title
        -boolean serious
        +getTitle() String
        +isSerious() boolean
    }

    %% ===== FACTORY METHOD (creational) =====
    class VehicleCreator {
        <<abstract, Creator>>
        +createVehicle(plate)* Vehicle
        +getTypeName()* String
    }
    class CarCreator
    class MotorcycleCreator
    class SuvVanCreator
    class TruckCreator

    class Vehicle {
        <<abstract, Product>>
        -String plate
        +getPlate() String
        +getType()* String
        +getHourlyRate()* int
        +getRequiredLetters()* int
        +getRequiredDigits()* int
        +getPlateHint()* String
        +hasValidPlate() boolean
        +hasOnlyLettersAndDigits() boolean
        +countLetters() int
        +countDigits() int
        +countCharacters() int
    }
    class Car
    class Motorcycle
    class SuvVan
    class Truck

    %% ===== DECORATOR (structural) =====
    class TicketText {
        <<interface, Component>>
        +render() String
    }
    class BasicTicket {
        <<ConcreteComponent>>
    }
    class TicketDecorator {
        <<abstract, Decorator>>
        #TicketText inner
        #ParkingRecord record
    }
    class TimeInDecorator
    class TimeOutDecorator
    class FeeDecorator
    class BorderDecorator {
        -int width
        ~setWidth(width)
    }
    class Tickets {
        +ticketFor(record, width) TicketText
        +receiptFor(record, width) TicketText
    }

    class VehicleIcon {
        <<Icon>>
        -String type
        +paintIcon(c, g, x, y)
    }

    %% ===== Relationships =====
    ParkingManagementSystem --> VehicleIcon : slot map picture
    VehicleIcon ..> Vehicle : drawn from getType()
    ParkingManagementSystem --> ParkingFacade : uses
    ParkingManagementSystem --> VehicleCreator : uses
    ParkingManagementSystem --> Tickets : uses
    ParkingManagementSystem ..> ParkingException : catches

    ParkingManagementSystem --> UIComponentFactory : creates UI
    UIComponentFactory <|.. DefaultUIComponentFactory
    ParkingManagementSystem ..> SlotButtonBuilder : builds slots
    SlotButtonBuilder --> UIComponentFactory : uses
    SlotButtonBuilder ..> SlotComponent : builds
    ParkingManagementSystem *-- SlotGrid
    SlotGrid o-- SlotComponent
    ParkingManagementSystem o-- LotObserver : notifies
    ParkingManagementSystem --> LayoutStrategy : uses
    LayoutStrategy <|.. BorderLayoutStrategy
    LayoutStrategy <|.. GridLayoutStrategy
    LayoutStrategy <|.. FlowLayoutStrategy

    ParkingFacade *-- SlotManager
    ParkingFacade *-- FeeCalculator
    ParkingFacade o-- ParkingRecord
    ParkingFacade ..> ParkingException : throws
    ParkingRecord --> Vehicle

    VehicleCreator <|-- CarCreator
    VehicleCreator <|-- MotorcycleCreator
    VehicleCreator <|-- SuvVanCreator
    VehicleCreator <|-- TruckCreator
    VehicleCreator ..> Vehicle : creates

    Vehicle <|-- Car
    Vehicle <|-- Motorcycle
    Vehicle <|-- SuvVan
    Vehicle <|-- Truck

    TicketText <|.. BasicTicket
    TicketText <|.. TicketDecorator
    TicketDecorator o-- TicketText : wraps
    TicketDecorator <|-- TimeInDecorator
    TicketDecorator <|-- TimeOutDecorator
    TicketDecorator <|-- FeeDecorator
    TicketDecorator <|-- BorderDecorator
    BasicTicket --> ParkingRecord
    Tickets ..> TicketText : builds
